{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Platform": "",
    "Redis": ""
  },
  "PlatformDatabase": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "ApiSecurity": {
    "AllowedOrigins": [],
    "RateLimitPermitsPerMinute": 300,
    "MaxRequestBodyBytes": 1048576,
    "AuthRateLimitPermitsPerMinute": 10,
    "RefreshRateLimitPermitsPerMinute": 30
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "App": {
    "PublicUrl": ""
  },
  "Jwt": {
    "Issuer": "database-ai-agent",
    "Audience": "database-ai-agent",
    "SigningKey": "",
    "AccessTokenMinutes": 10
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "RequireVerifiedEmail": true,
    "AllowPublicRegistration": false,
    "InvitationDays": 7,
    "PasswordResetTokenMinutes": 60,
    "EmailVerificationTokenDays": 2
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "Database AI Agent",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseTls": true,
    "SmtpUsername": "",
    "SmtpPassword": ""
  }
}
