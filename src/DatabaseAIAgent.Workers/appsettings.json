{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Platform": "",
    "Redis": ""
  },
  "PlatformDatabase": {
    "CommandTimeoutSeconds": 30
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "Database AI Agent",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseTls": true
  },
  "App": {
    "PublicUrl": ""
  },
  "Billing": {
    "AccountReference": "",
    "PastDueGraceDays": 7
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "PayPal": {
    "Mode": "Sandbox",
    "ClientId": "",
    "ClientSecret": "",
    "WebhookId": ""
  },
  "Encryption": {
    "Key": "",
    "PreviousKeys": []
  },
  "DatabaseConnections": {
    "AllowPrivateNetworks": false,
    "AllowLoopback": false
  },
  "Jobs": {
    "PollIntervalSeconds": 2,
    "ProcessInApi": false
  },
  "SchemaDiscovery": {
    "MaxTables": 5000,
    "MaxProcedures": 5000,
    "CommandTimeoutSeconds": 120
  },
  "Tools": {
    "AllowWriteTools": false,
    "DefaultTimeoutSeconds": 30,
    "DefaultMaxRows": 500,
    "DefaultMaxTextLength": 4000
  },
  "ToolExecution": {
    "MaxConcurrentPerConnection": 5,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerSeconds": 30
  }
}
