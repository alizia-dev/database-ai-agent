{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Platform": "",
    "Redis": ""
  },
  "PlatformDatabase": {
    "CommandTimeoutSeconds": 30
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "Database AI Agent",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseTls": true
  }
}
