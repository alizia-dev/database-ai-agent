# Copy to .env for local docker-compose. NEVER commit .env or real secrets.
# In production these come from a secret manager (Azure Key Vault / AWS Secrets Manager) as environment variables.

# --- Platform database (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Host "postgres" is the docker-compose service name; use localhost when running the API outside Docker.
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=database_ai_agent;Username=postgres;Password=change-me
# Generic alias used by some tooling; the API reads ConnectionStrings__Platform (mapped from POSTGRES_CONNECTION_STRING in compose).
DATABASE_CONNECTION_STRING=

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_CONNECTION_STRING=redis:6379,password=change-me,abortConnect=false

# --- Demo customer database (isolated Demo CRM, SQL Server) ---
DEMO_SQLSERVER_SA_PASSWORD=Change-me-Str0ng!

# --- Security ---
# Minimum 32 random bytes, base64-encoded (e.g. `openssl rand -base64 48`).
JWT_SECRET=
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Used to encrypt customer DB credentials at rest.
ENCRYPTION_KEY=

# --- AI providers (platform-level keys; never exposed to customers) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
